# Copy to .env.local for development. Never commit real secrets.

# Canonical public origin of the app. Used for SIWE domain/URI checks, cookie security and CSRF origin checks.
APP_URL=http://localhost:3000

# Postgres (local: docker compose up -d)
DATABASE_URL=postgres://alactic:alactic_dev_password@127.0.0.1:54329/alactic
# Used only by the integration test suite (tables are truncated during tests)
DATABASE_URL_TEST=postgres://alactic:alactic_dev_password@127.0.0.1:54329/alactic_test

# Chains accepted in SIWE messages (comma-separated EIP-155 IDs). 1 = Ethereum mainnet, 11155111 = Sepolia.
SIWE_ALLOWED_CHAIN_IDS=1,11155111
# Optional RPC URLs, used only to verify smart-contract-wallet signatures (EIP-1271/6492). Plain wallets are verified locally.
ETH_RPC_URL_MAINNET=
ETH_RPC_URL_SEPOLIA=


# 0G Compute Router (mainnet). The public model catalog needs no key; inference keys arrive in Phase 4.
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1

# Parent ENS name for managed agent subnames (<slug>.<parent>)
ENS_PARENT_NAME=alactic.eth
